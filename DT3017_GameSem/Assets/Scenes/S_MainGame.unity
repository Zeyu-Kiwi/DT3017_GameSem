    (Info NPC)","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":519,"yPos":829.001038},"ID":16,"ParamActions":[],"TMPFontGUID":null,"Text":"I''m
