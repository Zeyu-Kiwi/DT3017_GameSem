    (Info NPC)","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[{"__type":"EditableBoolCondition:#DialogueEditor","ParameterName":"is_sick_gone","CheckType":0,"RequiredValue":true}],"NodeUID":27}],"EditorInfo":{"isRoot":false,"xPos":1745,"yPos":825},"ID":25,"ParamActions":[],"TMPFontGUID":null,"Text":"Bent
